PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shopsavvy
CACHE_TTL_MINUTES=60
DARAZ_MODE=integration_pending
# Runs a daily background re-scrape (~90 queries, ~5 min) to build real price
# history. Off by default so a normal `npm run dev` doesn't silently start
# hammering four external sites. Set to true only on a machine meant to
# accumulate history, or run once manually with:
#   node src/scripts/run-scheduled-scrape.js
SCHEDULED_SCRAPING=false
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
SERPAPI_KEY=your_serpapi_key_here