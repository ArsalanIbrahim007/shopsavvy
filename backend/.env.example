PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shopsavvy
CACHE_TTL_MINUTES=60
DARAZ_MODE=integration_pending
# Runs a daily background re-scrape (~90 queries, ~5 min) to build real price
# history. Off by default so a normal `npm run dev` doesn't silently start
# hammering four external sites. Set to true only on a machine meant to
# accumulate history, or run once manually with:
#   node src/scripts/run-scheduled-scrape.js
SCHEDULED_SCRAPING=false
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
SERPAPI_KEY=your_serpapi_key_here
# Guards the endpoints that write by hand (POST /api/listings, POST /api/listings/:id/history)
# and forced re-scrapes (?refresh=true). Send it in the x-admin-key header. If this is empty the
# guarded endpoints are switched off. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
# Signs the confirm / cancel links in alert emails. Use a long random value (same command as ADMIN_API_KEY).
# Changing it invalidates outstanding links. If unset, a random one is used per run and links die on restart.
ALERT_TOKEN_SECRET=
# Where the links in alert emails point (this server's public address). Default: http://localhost:<PORT>.
# PUBLIC_BASE_URL=https://api.shopsavvy.example
# true skips the email confirmation and makes alerts active at once. Demonstrations on a machine with no mail
# delivery only: never on a deployed server, because it lets anyone subscribe any address.
# ALERT_AUTO_CONFIRM=false
# Set to false to skip filling the top-deals cache at start-up (the first deals request then computes it).
# WARM_DEALS=true
# Worker threads used for heavy product grouping (default 2, at most 8).
# GROUPING_WORKERS=2
# Websites allowed to read the API from a browser, comma separated, each an origin (scheme + host [+ port], no
# path, no wildcard). Not set = only localhost / 127.0.0.1 pages (local development). A deployment MUST set it, e.g.:
# CORS_ORIGINS=https://shopsavvy.example,https://www.shopsavvy.example
