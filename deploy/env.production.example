# The API's settings on the server: copied to /home/shopsavvy/shopsavvy/backend/.env by setup-server.sh, then filled in.
# Every value marked FILL must be set. Never commit the filled file.

PORT=5000
NODE_ENV=production

# FILL: the Atlas address (Atlas > Database > Connect > Drivers), with the database name "shopsavvy" before the "?".
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/shopsavvy?retryWrites=true&w=majority

# The API sits behind Caddy on the same machine: one proxy hop. Without it every visitor shares one rate limit.
TRUST_PROXY=1

# FILL: the website's address (Cloudflare Pages), and the API's own (the DuckDNS name).
CORS_ORIGINS=https://shopsavvy.pages.dev
PUBLIC_SITE_URL=https://shopsavvy.pages.dev
PUBLIC_BASE_URL=https://shopsavvy-api.duckdns.org

# FILL: two long random values, each from: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
ALERT_TOKEN_SECRET=

# The nightly refresh runs from the systemd timer (shopsavvy-scrape.timer), not inside the API.
SCHEDULED_SCRAPING=false
GROUPING_WORKERS=2

# Alert emails (optional until SMTP is ready: without it they only print to the log).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ShopSavvy <your.address@gmail.com>"
